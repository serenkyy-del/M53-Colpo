{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskRequest",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "application_key",
        "appointment_date",
        "birth_date",
        "first_name",
        "last_name",
        "middle_name",
        "operation",
        "patient_key",
        "sex",
        "task_name"
      ],
      "properties": {
        "application_key": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "appointment_date": {
          "$ref": "#/definitions/CalendarDate"
        },
        "birth_date": {
          "$ref": "#/definitions/BirthDate"
        },
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "middle_name": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "enum": [
            "upsert"
          ]
        },
        "patient_key": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sex": {
          "$ref": "#/definitions/Sex"
        },
        "task_name": {
          "description": "GUID of the 1C application, equal to application_key. Equality is checked by the server.",
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "application_key",
        "appointment_date",
        "operation",
        "task_name"
      ],
      "properties": {
        "application_key": {
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "appointment_date": {
          "$ref": "#/definitions/CalendarDate"
        },
        "operation": {
          "type": "string",
          "enum": [
            "cancel"
          ]
        },
        "task_name": {
          "description": "GUID of the 1C application, equal to application_key. Equality is checked by the server.",
          "type": "string",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "BirthDate": {
      "description": "Required string: empty means unknown, otherwise a real YYYY-MM-DD date. Null and missing are forbidden.",
      "anyOf": [
        {
          "type": "string",
          "const": ""
        },
        {
          "$ref": "#/definitions/CalendarDate"
        }
      ]
    },
    "CalendarDate": {
      "description": "Real Gregorian date YYYY-MM-DD, years 0001–9999. Pattern enforces calendar validity even when format validation is disabled.",
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "minLength": 10,
      "pattern": "^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)$"
    },
    "Sex": {
      "type": "string",
      "enum": [
        "F",
        "M",
        "O"
      ]
    }
  }
}