{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Publication",
  "type": "object",
  "required": [
    "id",
    "state",
    "study_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "notification_state": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string"
    },
    "study_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}