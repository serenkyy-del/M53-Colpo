{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OneCLoginResponse",
  "description": "A successful online check prepares this account's next local entry. Passwords and local password verifiers are never returned by the backend.",
  "type": "object",
  "required": [
    "auth_method",
    "me",
    "offline_grant",
    "session"
  ],
  "properties": {
    "auth_method": {
      "type": "string"
    },
    "me": {
      "$ref": "#/definitions/Me"
    },
    "offline_grant": {
      "$ref": "#/definitions/OfflineGrant"
    },
    "session": {
      "$ref": "#/definitions/Session"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DoctorIdentity": {
      "type": "object",
      "required": [
        "active",
        "display_name",
        "external_ids",
        "id",
        "origin"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "display_name": {
          "type": "string"
        },
        "external_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExternalDoctorId"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExternalDoctorId": {
      "type": "object",
      "required": [
        "doctor_guid",
        "source_id"
      ],
      "properties": {
        "doctor_guid": {
          "type": "string",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "Me": {
      "type": "object",
      "required": [
        "auth_provider",
        "auth_version",
        "credential_id",
        "display_name",
        "offline_policy",
        "organization_id",
        "roles",
        "server_time",
        "session_expires_at",
        "user_id",
        "workstation_id"
      ],
      "properties": {
        "auth_provider": {
          "type": "string"
        },
        "auth_version": {
          "type": "integer",
          "format": "int64"
        },
        "credential_id": {
          "type": "string",
          "format": "uuid"
        },
        "display_name": {
          "type": "string"
        },
        "doctor": {
          "anyOf": [
            {
              "$ref": "#/definitions/DoctorIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_user_guid": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "offline_policy": {
          "$ref": "#/definitions/OfflinePolicy"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "server_time": {
          "type": "integer",
          "format": "int64"
        },
        "session_expires_at": {
          "description": "Unix seconds; dates are UTC, independent of the workstation timezone.",
          "type": "integer",
          "format": "int64"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "workstation_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "OfflineGrant": {
      "type": "object",
      "required": [
        "expires_at",
        "grant",
        "grant_id",
        "key",
        "token_type"
      ],
      "properties": {
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant": {
          "type": "string"
        },
        "grant_id": {
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "description": "Convenience metadata, not a trust root: compare with a key obtained from the configured M53 server over authenticated TLS and kept in protected local storage. Never trust a replacement key just because it is inline.",
          "allOf": [
            {
              "$ref": "#/definitions/OfflinePublicKey"
            }
          ]
        },
        "token_type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "OfflinePolicy": {
      "type": "object",
      "required": [
        "allow_continue_open_encounter",
        "allow_local_print",
        "allow_new_manual_encounter",
        "enabled",
        "grant_days"
      ],
      "properties": {
        "allow_continue_open_encounter": {
          "type": "boolean"
        },
        "allow_local_print": {
          "type": "boolean"
        },
        "allow_new_manual_encounter": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "grant_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "OfflinePublicKey": {
      "description": "Public JWK; `x` is base64url without padding of the 32-byte Ed25519 public key.",
      "type": "object",
      "required": [
        "alg",
        "crv",
        "kid",
        "kty",
        "x"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "crv": {
          "type": "string"
        },
        "kid": {
          "type": "string"
        },
        "kty": {
          "type": "string"
        },
        "x": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "required": [
        "display_name",
        "token",
        "user_id"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}