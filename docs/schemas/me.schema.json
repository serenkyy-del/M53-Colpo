{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Me",
  "type": "object",
  "required": [
    "auth_provider",
    "auth_version",
    "credential_id",
    "display_name",
    "offline_policy",
    "organization_id",
    "roles",
    "server_time",
    "session_expires_at",
    "user_id",
    "workstation_id"
  ],
  "properties": {
    "auth_provider": {
      "type": "string"
    },
    "auth_version": {
      "type": "integer",
      "format": "int64"
    },
    "credential_id": {
      "type": "string",
      "format": "uuid"
    },
    "display_name": {
      "type": "string"
    },
    "doctor": {
      "anyOf": [
        {
          "$ref": "#/definitions/DoctorIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_user_guid": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "offline_policy": {
      "$ref": "#/definitions/OfflinePolicy"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "server_time": {
      "type": "integer",
      "format": "int64"
    },
    "session_expires_at": {
      "description": "Unix seconds; dates are UTC, independent of the workstation timezone.",
      "type": "integer",
      "format": "int64"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "workstation_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DoctorIdentity": {
      "type": "object",
      "required": [
        "active",
        "display_name",
        "external_ids",
        "id",
        "origin"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "display_name": {
          "type": "string"
        },
        "external_ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExternalDoctorId"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExternalDoctorId": {
      "type": "object",
      "required": [
        "doctor_guid",
        "source_id"
      ],
      "properties": {
        "doctor_guid": {
          "type": "string",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "OfflinePolicy": {
      "type": "object",
      "required": [
        "allow_continue_open_encounter",
        "allow_local_print",
        "allow_new_manual_encounter",
        "enabled",
        "grant_days"
      ],
      "properties": {
        "allow_continue_open_encounter": {
          "type": "boolean"
        },
        "allow_local_print": {
          "type": "boolean"
        },
        "allow_new_manual_encounter": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "grant_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}