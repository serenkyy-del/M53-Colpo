{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dictionary",
  "description": "Loaded by the server, never trusted from a client request.",
  "type": "object",
  "required": [
    "clinically_approved",
    "terms",
    "version_id"
  ],
  "properties": {
    "clinically_approved": {
      "type": "boolean"
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Term"
      }
    },
    "version_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Region": {
      "type": "string",
      "enum": [
        "cervix",
        "vagina",
        "vulva",
        "anus"
      ]
    },
    "Term": {
      "type": "object",
      "required": [
        "code",
        "kind",
        "region"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/TermKind"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "region": {
          "$ref": "#/definitions/Region"
        }
      },
      "additionalProperties": false
    },
    "TermKind": {
      "type": "string",
      "enum": [
        "finding",
        "anatomy",
        "test"
      ]
    }
  }
}