        "given_name"
      ],
      "properties": {
        "birth_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "family_name": {
          "type": "string"
        },
        "given_name": {
          "type": "string"
        },
        "patronymic": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}