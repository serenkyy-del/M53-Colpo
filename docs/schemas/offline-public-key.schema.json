{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OfflinePublicKey",
  "description": "Public JWK; `x` is base64url without padding of the 32-byte Ed25519 public key.",
  "type": "object",
  "required": [
    "alg",
    "crv",
    "kid",
    "kty",
    "x"
  ],
  "properties": {
    "alg": {
      "type": "string"
    },
    "crv": {
      "type": "string"
    },
    "kid": {
      "type": "string"
    },
    "kty": {
      "type": "string"
    },
    "x": {
      "type": "string"
    }
  },
  "additionalProperties": false
}