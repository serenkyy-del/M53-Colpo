{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyDetail",
  "type": "object",
  "required": [
    "annotations",
    "assets",
    "patient",
    "study"
  ],
  "properties": {
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Annotation"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Asset"
      }
    },
    "mis_task_bound": {
      "description": "Authoritative task binding; absent on older servers/caches means unverified.",
      "default": false,
      "type": "boolean"
    },
    "patient": {
      "$ref": "#/definitions/Patient"
    },
    "protocol": {
      "anyOf": [
        {
          "$ref": "#/definitions/Protocol"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "study": {
      "$ref": "#/definitions/Study"
    }
  },
  "definitions": {
    "Adequacy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "adequate"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "reason",
            "state"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "inadequate"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Annotation": {
      "type": "object",
      "required": [
        "asset_id",
        "id",
        "label",
        "radius",
        "x",
        "y"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "coordinate_system": {
          "default": "original_oriented_normalized_v1",
          "allOf": [
            {
              "$ref": "#/definitions/AnnotationSpace"
            }
          ]
        },
        "finding_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "label": {
          "type": "string"
        },
        "layer": {
          "$ref": "#/definitions/AnnotationLayer"
        },
        "lesion_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "radius": {
          "type": "number",
          "format": "float"
        },
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "AnnotationLayer": {
      "description": "Non-destructive layers in protocol_annotations, never in the original asset bytes.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "mark"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Arrow tail is x/y, tip is end_x/end_y in normalized original coordinates.",
          "type": "object",
          "required": [
            "end_x",
            "end_y",
            "kind"
          ],
          "properties": {
            "end_x": {
              "type": "number",
              "format": "float"
            },
            "end_y": {
              "type": "number",
              "format": "float"
            },
            "kind": {
              "type": "string",
              "enum": [
                "arrow"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "end_x",
            "end_y",
            "full_name",
            "kind"
          ],
          "properties": {
            "end_x": {
              "type": "number",
              "format": "float"
            },
            "end_y": {
              "type": "number",
              "format": "float"
            },
            "full_name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "callout"
              ]
            },
            "term_code": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "include_in_report",
            "kind",
            "rotation_degrees"
          ],
          "properties": {
            "include_in_report": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": [
                "target"
              ]
            },
            "rotation_degrees": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "x/y are the top-left in EXIF-oriented original coordinates; radius is unused.",
          "type": "object",
          "required": [
            "height",
            "kind",
            "width"
          ],
          "properties": {
            "height": {
              "type": "number",
              "format": "float"
            },
            "kind": {
              "type": "string",
              "enum": [
                "output_region"
              ]
            },
            "width": {
              "type": "number",
              "format": "float"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "AnnotationSpace": {
      "type": "string",
      "enum": [
        "original_oriented_normalized_v1"
      ]
    },
