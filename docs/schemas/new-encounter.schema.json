{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NewEncounter",
  "description": "A manual encounter keeps its actual local date when uploaded after an outage. The optional date exists solely to read legacy development requests.",
  "type": "object",
  "required": [
    "patient_id"
  ],
  "properties": {
    "encounter_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "patient_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false
}