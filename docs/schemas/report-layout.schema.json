{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReportLayout",
  "type": "object",
  "required": [
    "blocks",
    "photo_columns",
    "title"
  ],
  "properties": {
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReportBlock"
      }
    },
    "photo_columns": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    },
    "title": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ReportBlock": {
      "type": "string",
      "enum": [
        "patient",
        "indications",
        "history",
        "assessment",
        "findings",
        "photos",
        "conclusion",
        "recommendations",
        "signature"
      ]
    }
  }
}